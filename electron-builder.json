{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.relaydesk.app",
  "asar": true,
  "productName": "RelayDesk",
  "publish": {
    "provider": "github",
    "owner": "Zhqiankun",
    "repo": "RelayDesk",
    "releaseType": "release"
  },
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    "icon": "build/relaydesk-icon.png",
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "icon": "build/relaydesk.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "RelayDesk",
    "installerIcon": "build/relaydesk.ico",
    "uninstallerIcon": "build/relaydesk.ico",
    "installerHeaderIcon": "build/relaydesk.ico",
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "build/relaydesk-icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
